# Example environment file. Copy to .env and edit only what you need:
#   Copy-Item .env.example .env
#
# EVERY variable here is optional -- the system runs with no .env at all. Defaults live in
# common/config.py. All variables use the ADP_ prefix and are case-insensitive.

# ---------------------------------------------------------------------------
# Determinism
# ---------------------------------------------------------------------------
# Global seed for NumPy, random, PyTorch and LightGBM. Change only to test robustness;
# the demo and the reported metrics assume 42.
ADP_RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Environment / logging
# ---------------------------------------------------------------------------
ADP_ENVIRONMENT=local
ADP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Use mongodb://mongodb:27017 when running inside docker compose.
ADP_MONGO_URL=mongodb://localhost:27017
ADP_MONGO_DB_NAME=anomaly_detection
ADP_MONGO_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Redis (optional streaming transport -- the demo works without it)
# ---------------------------------------------------------------------------
ADP_REDIS_ENABLED=false
ADP_REDIS_URL=redis://localhost:6379/0
ADP_REDIS_STREAM_EVENTS=adp:events
ADP_REDIS_STREAM_DETECTIONS=adp:detections

# ---------------------------------------------------------------------------
# Artifacts
# ---------------------------------------------------------------------------
# Relative paths resolve against the repository root.
ADP_ARTIFACTS_DIR=artifacts
ADP_ARTIFACT_SCHEMA_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Alerting / risk fusion
# ---------------------------------------------------------------------------
# Fraction of events an analyst can review per period (the "alert budget").
ADP_ALERT_BUDGET_PCT=0.01
# Fused unsupervised score above which the classifier tier runs.
ADP_ANOMALY_GATE_THRESHOLD=0.55
# 0-100 risk at or above which a detection counts as an alert.
ADP_RISK_ALERT_THRESHOLD=60
# Fusion weights MUST sum to 1.0 or startup fails loudly.
ADP_FUSION_WEIGHT_BASELINE=0.35
ADP_FUSION_WEIGHT_SEQUENCE=0.30
ADP_FUSION_WEIGHT_CLASSIFIER=0.35

# ---------------------------------------------------------------------------
# Cold start
# ---------------------------------------------------------------------------
# Below this many sessions an entity is scored against cohort priors instead of its own.
ADP_ENTITY_HISTORY_MIN_SESSIONS=15
ADP_COLDSTART_UNCERTAINTY_MULTIPLIER=2.0

# ---------------------------------------------------------------------------
# Concept drift
# ---------------------------------------------------------------------------
ADP_DRIFT_WINDOW_SIZE=200
ADP_DRIFT_MIN_SAMPLES=50
ADP_DRIFT_PSI_THRESHOLD=0.20
ADP_DRIFT_REFRESH_ALPHA=0.05

# ---------------------------------------------------------------------------
# Feature pipeline
# ---------------------------------------------------------------------------
ADP_SEQUENCE_MAX_LEN=20
ADP_SEQUENCE_NGRAM_N=2
ADP_COHORT_COUNT=6
ADP_IMPOSSIBLE_TRAVEL_KMH=900
ADP_BRUTE_FORCE_THRESHOLD=5
ADP_BRUTE_FORCE_WINDOW_MINUTES=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Bearer token required by the scoring service. CHANGE THIS before exposing the service
# on any network -- the default is a development placeholder.
ADP_SCORING_AUTH_TOKEN=dev-scoring-token
ADP_SCORING_AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Optional LLM narrator (phrases an explanation; never affects a score)
# ---------------------------------------------------------------------------
# Leave disabled for an offline-safe demo. A deterministic template is used instead.
ADP_LLM_ENABLED=false
# ADP_GROQ_API_KEY=
ADP_GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# MITRE mapping source: static (zero dependencies) or qdrant
# ---------------------------------------------------------------------------
ADP_MITRE_MAP_SOURCE=static
# ADP_QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
ADP_API_PORT=8000
ADP_SERVING_PORT=8100
ADP_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
