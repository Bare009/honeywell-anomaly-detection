# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- virtual environments ---
.venv/
venv/
env/
ENV/

# --- test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- secrets / local config ---
.env
.env.local
.env.*.local

# --- trained artifacts -------------------------------------------------------
# Model binaries and generated datasets are reproducible from source (seed 42), so they
# are not tracked. Only the directory marker and the manifest are.
artifacts/*
!artifacts/.gitkeep
!artifacts/manifest.json

# Belt-and-braces: never track model binaries or datasets anywhere in the tree.
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.lgb
*.parquet
*.feather
*.h5

# --- notebooks ---
.ipynb_checkpoints/

# --- frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- reports / figures generated by evaluation ---
docs/figures/
docs/*.pdf

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
