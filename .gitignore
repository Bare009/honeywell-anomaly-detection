# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- virtual environments ---
.venv/
venv/
env/
ENV/

# --- test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- secrets / local config ---
.env
.env.local
.env.*.local

# --- trained artifacts -------------------------------------------------------
# Model binaries and generated datasets are reproducible from source (seed 42), so they
# are not tracked. Only the directory marker and the manifest are.
artifacts/*
!artifacts/.gitkeep
!artifacts/manifest.json

# Belt-and-braces: never track model binaries or datasets anywhere in the tree.
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.lgb
*.parquet
*.feather
*.h5

# --- notebooks ---
.ipynb_checkpoints/

# --- frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated at the repository root by `python -m evaluation.report`. The authored deliverable is
# DETAILED_REPORT.md; this is a machine-written summary of the metrics artifacts, so it is not
# tracked. Anchored with a leading slash so it does not also exclude docs/report/REPORT.md, which
# is a committed submission artifact.
/REPORT.md

# --- development-only notes, deliberately not part of the submission ---
Hackathon_Implementation_Plan.md
PROJECT_STATE.md
AI_Powered_Behavioral_Anomaly_Detection_Hackathon_Details.md

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
